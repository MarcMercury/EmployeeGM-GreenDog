{
  "name": "teamos-greendog",
  "version": "1.0.0",
  "description": "Enterprise Veterinary Workforce Management Platform",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "seed:users": "npx tsx scripts/create_users.ts",
    "db:migrate": "npx tsx scripts/apply-migrations.mjs",
    "db:types": "npx supabase gen types typescript --project-id <your-project-id> > types/database.types.ts",
    "lint:unused": "knip",
    "lint:deps": "depcheck",
    "lint:secrets": "node scripts/security/secret-sentinel.mjs --full",
    "lint:all": "npm run lint:unused && npm run lint:deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxtjs/supabase": "^2.0.9",
    "@pinia-plugin-persistedstate/nuxt": "^1.2.1",
    "@pinia/nuxt": "^0.11.3",
    "@sentry/node": "^10.63.0",
    "@sentry/vue": "^10.63.0",
    "@vee-validate/nuxt": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "apexcharts": "^5.16.0",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.11",
    "marked": "^17.0.1",
    "nuxt": "^4.4.8",
    "pinia": "^2.3.1",
    "qrcode.vue": "^3.10.0",
    "resend": "^6.17.1",
    "sass": "^1.101.0",
    "unpdf": "^1.6.2",
    "vee-validate": "^4.15.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "vue3-apexcharts": "^1.11.1",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.12.9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/google.maps": "^3.65.2",
    "autoprefixer": "^10.4.22",
    "csv-parse": "^6.1.0",
    "depcheck": "^1.4.7",
    "dotenv": "^16.6.1",
    "knip": "^5.82.1",
    "pg": "^8.22.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.6",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
